{
  "name": "maatify/realm",
  "description": "Official PHP library for maatify.dev Realm handler, known by our team",
  "type": "library",
  "keywords": [
    "PHP",
    "Realm",
    "Handler"
  ],
  "homepage": "https://github.com/Maatify/",
  "license": "proprietary",
  "authors": [
    {
      "name": "Mohamed Abdulalim",
      "email": "mohamed@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "Backend Developer"
    },
    {
      "name": "Ahmed Fawzy",
      "email": "a.fawzy@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "Frontend Developer"
    },
    {
      "name": "Ahmed Abdullah",
      "email": "a.abdullah@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "Android Developer"
    },
    {
      "name": "Elmokhtar Ahmed",
      "email": "mokhtar@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "IOS Developer"
    }
  ],
  "require": {
    "maatify/logger": "^5.0 || ^7.0",
    "maatify/json": "^5.0.4",
    "kreait/firebase-php": "^6.9",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10 || ^11 || ^12"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Realm\\": "realm/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Realm\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:logger-matrix": "bash scripts/verify-logger-matrix.sh"
  },
  "config": {
    "sort-packages": true,
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "block-scope": "all",
        "audit": "fail"
      },
      "abandoned": {
        "audit": "fail"
      }
    }
  }
}
